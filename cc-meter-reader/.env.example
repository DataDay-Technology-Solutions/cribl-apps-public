# Copy to .env (git-ignored). Never commit real values.
# Cribl.Cloud API credential (Organization → API Credentials), used only by scripts/ for
# deploy/upgrade/validation. The App itself never uses these.
CRIBL_CLIENT_ID=
CRIBL_CLIENT_SECRET=
CRIBL_ORG=
CRIBL_WORKSPACE=main
# Demo alert receiver (webhook.site URL), authorized post-install under App Settings → External API Access
MR_DEMO_WEBHOOK_URL=
